      - validation

  MTA-00201:
    title: Invalid log level
    category: model
    severity: error
    description: A log model received an unsupported logging level.
    solution: Use DEBUG, INFO, WARNING, ERROR or CRITICAL as appropriate for the model.
    exception: pydantic.ValidationError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
