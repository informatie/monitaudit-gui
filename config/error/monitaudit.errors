# config/error/monitaudit.errors
#
# MonitAudit machine-readable error catalogue
# Version: 1.4.0
#
# IMPORTANT:
# - Error codes are permanent once published.
# - Published codes must never be reused for another condition.
# - Runtime values must not be stored in this catalogue.
# - Runtime context is supplied when an error occurs.
# - The mapping key is the authoritative error code.
# - The most specific applicable error code must be used.
# - Generic sink and I/O codes are fallback codes.
# - Application exceptions observed by tracing are not MTA errors.

catalogue:
  name: MonitAudit
  version: 1.4.0
  code_prefix: MTA
  code_pattern: '^MTA-\d{5}$'
  resolution_policy: most_specific

  severity_policy:
    debug: Diagnostic condition with no operational impact.
    info: Informational condition requiring no corrective action.
    warning: Degraded behaviour while the operation can continue.
    error: An operation failed but MonitAudit may continue.
    critical: MonitAudit integrity or continued operation is at risk.

  ranges:
    general:
      start: MTA-00001
      end: MTA-00099

    logger:
      start: MTA-00100
      end: MTA-00199

    model:
      start: MTA-00200
      end: MTA-00299

    tracing:
      start: MTA-00300
      end: MTA-00399

    configuration:
      start: MTA-00400
      end: MTA-00499

    sink:
      start: MTA-00500
      end: MTA-00599

    console_sink:
      start: MTA-00600
      end: MTA-00699

    file_sink:
      start: MTA-00700
      end: MTA-00799

    json_sink:
      start: MTA-00800
      end: MTA-00899

    delta_sink:
      start: MTA-00900
      end: MTA-00999

    serialization:
      start: MTA-01000
      end: MTA-01099

    security:
      start: MTA-01100
      end: MTA-01199

    runtime:
      start: MTA-01200
      end: MTA-01299

    internal:
      start: MTA-01300
      end: MTA-01399

    io:
      start: MTA-01400
      end: MTA-01499

    error_catalogue:
      start: MTA-01500
      end: MTA-01599

    unexpected:
      start: MTA-09900
      end: MTA-09999


errors:

  # =========================================================================
  # GENERAL VALIDATION
  # MTA-00001 - MTA-00099
  # =========================================================================

  MTA-00001:
    title: Invalid parameter
    category: general
    severity: error
    description: A parameter contains an invalid value.
    solution: Verify the parameter value and the calling procedure.
    exception: builtins.ValueError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - parameter
      - value
    tags:
      - validation
      - parameter

  MTA-00002:
    title: Missing required parameter
    category: general
    severity: error
    description: A required parameter was not supplied.
    solution: Supply the required parameter and retry the operation.
    exception: builtins.ValueError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - parameter
    tags:
      - validation
      - parameter

  MTA-00003:
    title: Invalid parameter type
    category: general
    severity: error
    description: A parameter has an unsupported type.
    solution: Verify the expected parameter type and supplied value.
    exception: builtins.TypeError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - parameter
      - expected_type
      - actual_type
    tags:
      - validation
      - parameter
      - type

  MTA-00004:
    title: Empty required value
    category: general
    severity: error
    description: A required value is empty.
    solution: Supply a non-empty value.
    exception: builtins.ValueError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - parameter
    tags:
      - validation

  MTA-00005:
    title: Value outside allowed range
    category: general
    severity: error
    description: A numeric value is outside its permitted range.
    solution: Verify the configured minimum and maximum values.
    exception: builtins.ValueError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - parameter
      - value
      - minimum
      - maximum
    tags:
      - validation
      - range


  # =========================================================================
  # LOGGER
  # MTA-00100 - MTA-00199
  # =========================================================================

  MTA-00100:
    title: Logger initialisation failed
    category: logger
    severity: error
    description: The MonitAudit logger could not be initialised.
    solution: Verify the logging context, configured sinks and logger settings.
    exception: builtins.RuntimeError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context: []
    tags:
      - logger

  MTA-00101:
    title: Invalid logging context
    category: logger
    severity: error
    description: The logger received an invalid LogContext.
    solution: Supply a valid LogContext instance.
    exception: builtins.TypeError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - actual_type
    tags:
      - logger
      - context
      - validation

  MTA-00102:
    title: Invalid sink
    category: logger
    severity: error
    description: A configured sink does not implement the Sink contract.
    solution: Verify that every configured sink inherits from Sink.
    exception: builtins.TypeError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - sink
      - actual_type
    tags:
      - logger
      - sink
      - validation

  MTA-00103:
    title: Invalid sink failure mode
    category: logger
    severity: error
    description: The configured sink failure mode is unsupported.
    solution: Use continue or raise.
    exception: builtins.ValueError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - sink_failure_mode
    tags:
      - logger
      - sink
      - validation

  MTA-00104:
    title: Logger sink failure
    category: logger
    severity: error
    description: One or more sinks failed while processing a log record.
    solution: Inspect the specific sink failure codes and affected destinations.
    exception: builtins.RuntimeError
    retryable: true
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - sinks
    tags:
      - logger
      - sink

  MTA-00105:
    title: Caller information unavailable
    category: logger
    severity: warning
    description: MonitAudit could not determine the originating module or function.
    solution: Supply module and function explicitly when caller information is required.
    exception: null
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context: []
    tags:
      - logger
      - caller
      - diagnostic


  # =========================================================================
  # LOG MODELS AND CONTEXT
  # MTA-00200 - MTA-00299
  # =========================================================================

  MTA-00200:
