    tags:
      - model
      - validation
      - level

  MTA-00202:
    title: Invalid log message
    category: model
    severity: error
    description: The log message is invalid or empty.
    solution: Supply a non-empty log message.
    exception: pydantic.ValidationError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context: []
    tags:
      - model
      - message
      - validation

  MTA-00203:
