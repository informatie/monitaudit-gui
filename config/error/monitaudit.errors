  MTA-00300:
    title: Trace initialisation failed
    category: tracing
    severity: error
    description: MonitAudit could not initialise tracing for a function.
    solution: Verify the traced callable and tracing configuration.
    exception: builtins.RuntimeError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - function
    tags:
      - tracing

  MTA-00301:
    title: Trace parameter binding failed
    category: tracing
    severity: error
    description: Function arguments could not be bound to the traced function signature.
    solution: Verify the supplied arguments and function signature.
    exception: builtins.TypeError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - function
    tags:
      - tracing
      - parameters

  MTA-00302:
    title: Parameter capture failed
    category: tracing
    severity: error
    description: MonitAudit could not capture parameters for a traced function.
    solution: Verify the arguments supplied to the traced function.
    exception: builtins.RuntimeError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - function
    tags:
      - tracing
      - parameters

  MTA-00303:
    title: Trace parameter redaction failed
    category: tracing
    severity: error
    description: Captured trace parameters could not be redacted.
    solution: Verify the captured parameter structure and nested values.
    exception: builtins.RuntimeError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - function
    tags:
      - tracing
      - security
      - redaction

  MTA-00304:
    title: Trace parameter serialisation failed
    category: tracing
    severity: error
    description: Captured trace parameters could not be converted to JSON-safe values.
    solution: Verify parameter types and custom objects.
    exception: builtins.RuntimeError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - function
    tags:
      - tracing
      - serialization

  MTA-00305:
    title: Parameter size limiting failed
    category: tracing
    severity: error
    description: Captured parameters could not be limited to the configured size.
    solution: Verify max_parameter_length and the captured parameter structure.
    exception: builtins.RuntimeError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - max_parameter_length
    tags:
      - tracing
      - parameters

  MTA-00306:
    title: Reserved
    category: tracing
    severity: error
    description: Reserved for a future MonitAudit tracing failure.
    solution: No corrective action is defined for this reserved code.
    exception: null
    retryable: false
    status: reserved
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context: []
    tags:
