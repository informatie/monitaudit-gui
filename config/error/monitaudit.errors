    solution: Verify the runtime path and filesystem permissions.
    exception: monitaudit.utilities.load_config.ConfigurationError
    retryable: true
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - path
    tags:
      - configuration
      - runtime
      - io

  MTA-00411:
    title: Empty runtime configuration
    category: configuration
    severity: error
    description: The runtime configuration file contains no configuration.
    solution: Add the required MonitAudit runtime configuration.
    exception: monitaudit.utilities.load_config.ConfigurationError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - path
    tags:
      - configuration
      - runtime

  MTA-00412:
