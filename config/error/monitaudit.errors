      - runtime

  MTA-00409:
    title: Multiple runtime configuration files
    category: configuration
    severity: error
    description: Multiple supported runtime configuration files were discovered.
    solution: Keep only one automatically discoverable runtime configuration file.
    exception: monitaudit.utilities.load_config.ConfigurationError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
