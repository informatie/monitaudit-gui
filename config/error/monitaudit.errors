    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - path
    tags:
      - configuration
      - properties
      - file

  MTA-00402:
    title: Properties path is not a file
    category: configuration
    severity: error
    description: The configured properties path does not reference a file.
    solution: Configure a valid properties file path.
    exception: monitaudit.utilities.load_config.ConfigurationError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - path
    tags:
      - configuration
      - properties
      - file

  MTA-00403:
