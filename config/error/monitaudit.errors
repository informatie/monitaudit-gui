    category: model
    severity: error
    description: The log duration is outside the supported range.
    solution: Supply duration_ms as zero or greater.
    exception: pydantic.ValidationError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - duration_ms
    tags:
      - model
      - duration
      - validation

  MTA-00204:
    title: Invalid LogContext application
    category: model
    severity: error
    description: A LogContext was constructed with an invalid application name.
    solution: Supply a non-empty application name.
    exception: pydantic.ValidationError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - application
    tags:
      - model
      - context
      - application

  MTA-00205:
    title: Invalid LogContext environment
    category: model
    severity: error
    description: A LogContext was constructed with an invalid environment value.
    solution: Supply a valid environment value.
    exception: pydantic.ValidationError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - environment
    tags:
      - model
      - context
      - environment

  MTA-00206:
    title: Invalid correlation identifier
    category: model
    severity: error
    description: The correlation identifier is invalid.
    solution: Verify the supplied correlation identifier.
    exception: pydantic.ValidationError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context:
      - correlation_id
    tags:
      - model
      - correlation

  MTA-00207:
    title: Invalid traceback
    category: model
    severity: error
    description: Traceback information cannot be represented by the target log model.
    solution: Supply traceback information as the supported sequence of strings.
    exception: pydantic.ValidationError
    retryable: false
    status: active
    introduced: 1.4.0
    deprecated: null
    replaced_by: null
    documentation: null
    context: []
    tags:
